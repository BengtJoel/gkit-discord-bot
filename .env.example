# Discord Developer Portal → din applikation
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Adressen dashboarden nås på. Lägg till  <PUBLIC_URL>/api/auth/callback  som Redirect under OAuth2 i Developer Portal.
PUBLIC_URL=https://bot.example.com

# Slumpad sträng, minst 32 tecken:  openssl rand -hex 32
SESSION_SECRET=

# Ditt Discord-ID (kommaseparerat för flera). Får hantera alla servrar boten är med i.
OWNER_IDS=

# Byt till något eget innan första start
POSTGRES_PASSWORD=guildbot

# Valfritt: token för Cloudflare Tunnel (docker compose --profile tunnel up -d)
CLOUDFLARE_TUNNEL_TOKEN=

LOG_LEVEL=info
